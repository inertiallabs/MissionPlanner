  <messages>
    <message id="699" name="AHRS_ADDITIONAL_RAW_INFO">
      <description>Additional GPS and INS parameters.</description>
      <field type="int32_t" name="lat_raw" units="degE7">Latitude (WGS84, EGM96 ellipsoid)</field>
      <field type="int32_t" name="lon_raw" units="degE7">Longitude (WGS84, EGM96 ellipsoid)</field>
      <field type="int32_t" name="alt_raw" units="mm">Altitude (MSL). Positive for up. Note that virtually all GPS modules provide the MSL altitude in addition to the WGS84 altitude.</field>
      <field type="uint16_t" name="track_over_ground_raw" units="cdeg">Yaw in earth frame from north. Use 0 if this GPS does not provide yaw. Use 36000 for north.</field>
      <field type="uint8_t" name="gps_raw_status">Status for GPS data</field>
      <field type="uint32_t" name="ins_lat_accuracy" units="mm">INS latitude accuracy.</field>
      <field type="uint32_t" name="ins_lng_accuracy" units="mm">INS longitude accuracy.</field>
      <field type="uint32_t" name="ins_alt_accuracy" units="mm">INS altitude accuracy.</field>
    </message>
    <!-- EAHRS messages -->
    <message id="700" name="EAHRS_STATUS_INFO">
      <description>Info about EAHRS status.</description>
      <field type="uint16_t" name="status1" display="bitmask">Status flags1.</field>
      <field type="uint16_t" name="status2" display="bitmask">Status flags2.</field>
      <field type="uint16_t" name="status3" display="bitmask">Status flags3.</field>
      <field type="uint16_t" name="status4" display="bitmask">Status flags4.</field>
      <field type="uint16_t" name="status5" display="bitmask">Status flags5.</field>
    </message>
  </messages>
</mavlink>
