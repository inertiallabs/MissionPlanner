      </entry>
      <entry value="33005" name="MAV_CMD_EXTERNAL_AHRS_STOP_VG3D_CALIBRATION_IN_FLIGHT" hasLocation="false" isDestination="false">
        <description>Send command "stop vg3d calibration in flight" to external AHRS</description>
