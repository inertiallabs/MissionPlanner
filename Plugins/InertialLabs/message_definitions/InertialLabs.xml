        <param index="3" label="LongitudeStd" units="m">Longitude STD</param>
        <param index="4" label="AltitudeStd" units="m">Altitude STD</param>
        <param index="5" label="Latitude" units="degE7">Latitude</param>
        <param index="6" label="Longitude" units="degE7">Longitude</param>
        <param index="7" label="Altitude" units="m">Altitude</param>
      </entry>
      <entry value="33007" name="MAV_CMD_EXTERNAL_AHRS_AIDING_DATA_EXTERNAL_HORIZONTAL_POSITION" hasLocation="true" isDestination="false">
        <description>Send external horizontal position aiding data to AHRS</description>
