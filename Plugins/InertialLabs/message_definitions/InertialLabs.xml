        <param index="7">Empty.</param>
      </entry>
      <entry value="33006" name="MAV_CMD_EXTERNAL_AHRS_AIDING_DATA_EXTERNAL_POSITION" hasLocation="true" isDestination="false">
        <description>Send external position aiding data to AHRS</description>
        <param index="1" label="Latency" units="s">Latency</param>
